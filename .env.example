# Lielu Lists — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# Full reference: docs/ENVIRONMENT.md

# Public base URL of the deployment, without trailing slash.
# Production: https://lists.lielu.eu   Local: http://localhost:3000
APP_URL=http://localhost:3000

# PostgreSQL. Production: Neon project "lielu-lists" — use the POOLED connection
# string (host contains "-pooler"). Neon console › Connect › "Connection pooling" ON.
# Any PostgreSQL works (Neon, Supabase transaction pooler, local).
DATABASE_URL=postgresql://<role>:<password>@ep-<id>-pooler.eu-central-1.aws.neon.tech/lielu_lists?sslmode=require
# Optional: force TLS mode ("require" | "disable"). Auto: disabled for localhost, required otherwise.
# DATABASE_SSL=require

# TMDB "API Read Access Token" (v4 bearer) — themoviedb.org › Settings › API.
TMDB_API_READ_ACCESS_TOKEN=

# 32 random bytes: 64 hex chars (https://generate-secret.vercel.app/64) or base64 (npm run gen:secret).
# Encrypts TMDB tokens at rest.
TOKEN_ENCRYPTION_KEY=
# Only during a key rotation: the previous key, still accepted for decryption.
# TOKEN_ENCRYPTION_KEY_PREVIOUS=

# >= 32 chars (npm run gen:secret). Keys the hashes of sessions, Stremio ids and rate-limit keys.
HASH_SECRET=

# >= 32 chars (npm run gen:secret). Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Optional tuning
# SYNC_INTERVAL_MINUTES=15
# CRON_TIME_BUDGET_SECONDS=240
# LOG_LEVEL=info
